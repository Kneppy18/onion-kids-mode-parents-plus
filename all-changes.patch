+# ------------------------------ game rentals --------------------------------
+# rentals.txt holds one "<expiry epoch>|<rompath>" line per rented game. When
+# the expiry passes, the game is removed from Onion's Favorites (so Kids Mode
+# no longer lists it). The ROM and the child's saves are not touched; adding
+# the game back to Favorites restores it with its progress. A line may also be
+# written by hand as "<days>|<rompath>" (days < 100000); it is stamped with its
+# expiry time the first time it is seen.
+
+# Parent menu: rent the highlighted game for $1 days (0 = cancel the rental).
+set_game_rental() {
+    rent_days="$1"
+    case "$rent_days" in '' | *[!0-9]*) return 0 ;; esac
+    rent_path="$(sed -n 1p "$game_selection_file" 2> /dev/null)"
+    rent_label=""
+    if [ -n "$rent_path" ] && [ -f "$favfile" ]; then
+        rent_label="$(jq -r --arg p "$rent_path" \
+            'select(.rompath == $p) | .label' "$favfile" 2> /dev/null | head -n 1)"
+    fi
+    if [ -z "$rent_label" ]; then
+        infoPanel -t "Rentals" -m "Highlight a game in the\ncarousel first." --auto
+        log "Rental request ignored; no matching favorite for: $rent_path"
+        return 0
+    fi
+    mkdir -p "$backupdir"
+    tmp_rentals="$rentals_file.tmp.$$"
+    : > "$tmp_rentals"
+    if [ -f "$rentals_file" ]; then
+        # Drop any earlier rental line for this same game
+        awk -F'|' -v p="$rent_path" '
+            { i = index($0, "|"); if (substr($0, i + 1) != p) print }
+        ' "$rentals_file" > "$tmp_rentals"
+    fi
+    if [ "$rent_days" -gt 0 ]; then
+        printf '%s|%s\n' "$(($(date +%s) + rent_days * 86400))" "$rent_path" \
+            >> "$tmp_rentals"
+        mv -f "$tmp_rentals" "$rentals_file"
+        log "Rental set: $rent_label for $rent_days day(s)."
+        infoPanel -t "Rentals" -m "$rent_label\nrented for $rent_days day(s)." --auto
+    else
+        mv -f "$tmp_rentals" "$rentals_file"
+        log "Rental canceled: $rent_label"
+        infoPanel -t "Rentals" -m "$rent_label\nrental canceled." --auto
+    fi
+}
+
+expire_rentals() {
+    [ -f "$rentals_file" ] || return 0
+    now="$(date +%s)"
+    out="$rentals_file.tmp.$$"
+    : > "$out"
+    cr="$(printf '\r')"
+    while IFS='|' read -r when rpath || [ -n "$when" ]; do
+        rpath="${rpath%$cr}"
+        [ -n "$when" ] && [ -n "$rpath" ] || continue
+        case "$when" in *[!0-9]*) continue ;; esac
+        [ "$when" -lt 100000 ] && when=$((now + when * 86400))
+        if [ "$now" -ge "$when" ] && [ -f "$favfile" ] &&
+            jq -c --arg p "$rpath" 'select(.rompath != $p)' \
+                "$favfile" > "$favfile.tmp.$$" 2> /dev/null &&
+            mv -f "$favfile.tmp.$$" "$favfile"; then
+            log "Rental expired; removed from favorites: $rpath"
+        else
+            rm -f "$favfile.tmp.$$"
+            printf '%s|%s\n' "$when" "$rpath" >> "$out"
+        fi
+    done < "$rentals_file"
+    mv -f "$out" "$rentals_file"
+}
