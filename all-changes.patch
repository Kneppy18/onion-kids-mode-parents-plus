+# ---------------- Daily schedule (weekday / weekend) ------------------------
+# Everything here is changed from the parent menu and stored in
+# schedule_minutes.txt on the SD card (6 lines: weekday minutes, weekend
+# minutes, weekday window start, weekday window end, weekend window start,
+# weekend window end; times are 24-hour HHMM). The defaults below apply until
+# the parent changes them.
+DEFAULT_WEEKDAY_MINUTES=30
+DEFAULT_WEEKEND_MINUTES=60
+DEFAULT_WEEKDAY_PLAY_START=1600   # Mon-Fri: playable 4:00 pm ...
+DEFAULT_WEEKDAY_PLAY_END=1900     # ... until 7:00 pm
+DEFAULT_WEEKEND_PLAY_START=0800   # Sat-Sun: playable 8:00 am ...
+DEFAULT_WEEKEND_PLAY_END=1900     # ... until 7:00 pm
+schedule_file="$backupdir/schedule_minutes.txt"
+bypass_file="$backupdir/bypass_until"           # last bypass day, YYYYMMDD
+rentals_file="$backupdir/rentals.txt"           # "<expiry epoch>|<rompath>"
+
+schedule_default() { # $1 = line number 1..6
+    case "$1" in
+        1) echo "$DEFAULT_WEEKDAY_MINUTES" ;;
+        2) echo "$DEFAULT_WEEKEND_MINUTES" ;;
+        3) echo "$DEFAULT_WEEKDAY_PLAY_START" ;;
+        4) echo "$DEFAULT_WEEKDAY_PLAY_END" ;;
+        5) echo "$DEFAULT_WEEKEND_PLAY_START" ;;
+        6) echo "$DEFAULT_WEEKEND_PLAY_END" ;;
+    esac
+}
+
+# Value of line $1 of the schedule file, or its default when missing/invalid.
+schedule_get() {
+    g_v=""
+    [ -f "$schedule_file" ] &&
+        g_v="$(sed -n "${1}p" "$schedule_file" 2> /dev/null | tr -d '\r')"
+    case "$1" in
+        1 | 2) case "$g_v" in '' | *[!0-9]* | 0) g_v="" ;; esac ;;
+        *) case "$g_v" in [0-2][0-9][0-5][0-9]) ;; *) g_v="" ;; esac ;;
+    esac
+    [ -n "$g_v" ] || g_v="$(schedule_default "$1")"
+    echo "$g_v"
+}
+
+# Set line $1 to value $2, keeping the other five values.
+schedule_set() {
+    ss_1="$(schedule_get 1)"
+    ss_2="$(schedule_get 2)"
+    ss_3="$(schedule_get 3)"
+    ss_4="$(schedule_get 4)"
+    ss_5="$(schedule_get 5)"
+    ss_6="$(schedule_get 6)"
+    case "$1" in
+        1) ss_1="$2" ;;
+        2) ss_2="$2" ;;
+        3) ss_3="$2" ;;
+        4) ss_4="$2" ;;
+        5) ss_5="$2" ;;
+        6) ss_6="$2" ;;
+    esac
+    mkdir -p "$backupdir"
+    printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$ss_1" "$ss_2" "$ss_3" "$ss_4" \
+        "$ss_5" "$ss_6" > "$schedule_file.tmp" &&
+        mv -f "$schedule_file.tmp" "$schedule_file"
+}
+
+schedule_minutes() { # $1 = weekday | weekend
+    if [ "$1" = weekend ]; then schedule_get 2; else schedule_get 1; fi
+}
+
+# Bypass ("vacation mode"): active through the date stored in bypass_file.
+bypass_active() {
+    b=""
+    [ -f "$bypass_file" ] && IFS= read -r b < "$bypass_file"
+    case "$b" in '' | *[!0-9]*) return 1 ;; esac
+    [ "$b" -ge "$(date +%Y%m%d)" ]
+}
+
+hhmm_to_secs() { # $1 = HHMM
+    t_h="${1%??}"
+    t_m="${1#??}"
+    t_h="${t_h#0}"
+    t_m="${t_m#0}"
+    echo $((${t_h:-0} * 3600 + ${t_m:-0} * 60))
+}
+
+now_secs() {
+    n_h="$(date +%H)"
+    n_m="$(date +%M)"
+    n_s="$(date +%S)"
+    n_h="${n_h#0}"
+    n_m="${n_m#0}"
+    n_s="${n_s#0}"
+    echo $((${n_h:-0} * 3600 + ${n_m:-0} * 60 + ${n_s:-0}))
+}
+
+# Seconds until today's play window closes; 0 when outside the window.
+# During a bypass the window does not apply.
+schedule_window_left() {
+    bypass_active && {
+        echo 999999
+        return 0
+    }
+    if [ "$(date +%u)" -le 5 ]; then
+        w_start="$(schedule_get 3)"
+        w_end="$(schedule_get 4)"
+    else
+        w_start="$(schedule_get 5)"
+        w_end="$(schedule_get 6)"
+    fi
+    w_now="$(now_secs)"
+    w_s="$(hhmm_to_secs "$w_start")"
+    w_e="$(hhmm_to_secs "$w_end")"
+    if [ "$w_now" -lt "$w_s" ] || [ "$w_now" -ge "$w_e" ]; then
+        echo 0
+    else
+        echo $((w_e - w_now))
+    fi
+}
+
+# Today's total budget in seconds (daily minutes + bonus added today).
+# During a bypass only hand-added bonus time counts; 0 means unlimited.
+effective_budget() {
+    if bypass_active; then
+        echo "$(state_bonus)"
+        return 0
+    fi
+    if [ "$(date +%u)" -le 5 ]; then
+        echo $(($(schedule_minutes weekday) * 60 + $(state_bonus)))
+    else
+        echo $(($(schedule_minutes weekend) * 60 + $(state_bonus)))
+    fi
+}
+
+# New calendar day: wipe used time and bonus.
+daily_rollover() {
+    d_today="$(date +%Y-%m-%d)"
+    d_disk=""
+    [ -f "$timer_state" ] && IFS= read -r d_disk < "$timer_state"
+    [ "$d_disk" = "$d_today" ] && return 0
+    printf '0\n' > "$timer_runtime_used.rollover" &&
+        mv -f "$timer_runtime_used.rollover" "$timer_runtime_used"
+    mkdir -p "$backupdir"
+    printf '%s\n0\n0\n' "$d_today" > "$timer_state.tmp" &&
+        mv -f "$timer_state.tmp" "$timer_state"
+    rm -f "$timesup_since_file" "$timesup_resume_file" "$timesup_resume_file.tmp"
+    log "New day: daily play time reset."
+}
